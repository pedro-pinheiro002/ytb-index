{
  "name": "ytb-index",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  // Required by @sentry/cloudflare (ADR-0006).
  "compatibility_flags": ["nodejs_compat"],
  // Workers Observability: every invocation's logs, status and latency,
  // queryable in the dashboard. Complements Sentry, which only sees errors.
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "ytb_index",
      "database_name": "ytb-index",
      "database_id": "fbd4036f-9486-4c20-a6d4-47e74d2c8bc6",
      "migrations_dir": "migrations",
    },
  ],
  // repository_dispatch coordinates for the operator ingest API (ADR-0005).
  // Public info — safe in the repo. The secrets are set out-of-band:
  //   wrangler secret put OPERATOR_TOKEN    # Bearer token for POST /api/ingest
  //   wrangler secret put GH_DISPATCH_PAT   # fine-grained PAT, Contents: write
  "vars": {
    "GH_OWNER": "pedro-pinheiro002",
    "GH_REPO": "ytb-index",
    // Error reporting for the repair agent (ADR-0006). The DSN is public by
    // design — it ships in the bundle — so the webhook does not trust the
    // payload; SENTRY_HOOK_SECRET is what authenticates the dispatch.
    //   wrangler secret put SENTRY_HOOK_SECRET   # Sentry Internal Integration's client secret
    //   AGENT_ENABLED="false" is the kill switch: /api/agent-hook answers 503.
    // Project 4512335906078720, org 4512335884976128 (US region).
    "SENTRY_DSN": "https://a91ef9065059015f47c655a000e1ae1f@o4512335884976128.ingest.us.sentry.io/4512335906078720",
    "AGENT_ENABLED": "true",
    // OperatorKey sealing (ADR-0008, F6 #51): the PUBLIC RSA-OAEP-256 JWK from
    // `pnpm exec tsx scripts/gen-seal-keypair.ts`, pasted as the JSON object
    // value (a JSON string also works).
    // Public by design; the private half is the INGEST_SEAL_PRIVATE_KEY repo
    // secret. Empty = OperatorKey triggers are disabled and fail closed (503);
    // triggers without a key still run on the repo YOUTUBE_API_KEY.
    // Generated 2026-10-29; rotate by replacing this and the repo secret together.
    "INGEST_SEAL_PUBLIC_KEY": {
      "key_ops": ["encrypt"],
      "ext": true,
      "alg": "RSA-OAEP-256",
      "kty": "RSA",
      "n": "ohEzhIB4GGmuPCBOhvqwu-U_khmXnWQiwhxmb06CaJ-HMA3oFxkeHg-aqfw9knIwOUxeciKGzSwI1rpbrCblBYFzUlnNiPp2vuxptTt2rgI_XLObyRvOPOvNYgl0Uj2fe9fJZmbJF_WUgQL0dpoRwfJ8Piu2qFpJMQDIHzJQ6LIwTwfXYw_wwlXUwkykyM1MpkmPZfjAY_VnH8xMxztN1xhIfgMjWmZLdw7ybeUNsszvl2vO5cjBMwdAy1-B9XGeMaUvpQiJ2jcyvCV1rdOMBiIQv9YsoudCvpbVnsXPu0p22FsEbOczJ5j-077UhMndn-5BGaCD0gbNtubpKhA8qw",
      "e": "AQAB",
    },
  },
}

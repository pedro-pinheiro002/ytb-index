# Copy to `.env` and fill locally. `.env` is gitignored — never commit real values (ADR-0003).

# YouTube Data API v3 key — required by every ingest run.
YOUTUBE_API_KEY=AIza...

# Cloudflare D1 HTTP API credentials — required by `pnpm ingest <channel> --remote`.
# The token needs D1 Write plus Workers Scripts Write — the "Edit Cloudflare
# Workers" template does NOT include D1, so add D1 Write to it. Scope it to your account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=

# Operator ingest API (ADR-0005) — local `pnpm dev` only. In production these
# are Worker secrets set out-of-band:
#   wrangler secret put OPERATOR_TOKEN    # Bearer token for POST /api/ingest
#   wrangler secret put GH_DISPATCH_PAT   # fine-grained PAT, Contents: write
OPERATOR_TOKEN=
GH_DISPATCH_PAT=

# OperatorKey sealing (ADR-0008). Generate the pair once with
# `pnpm exec tsx scripts/gen-seal-keypair.ts`.
# Server side (`pnpm dev`): the public JWK, one line of JSON. Empty disables
# OperatorKey triggers (503). In production it is a Worker var in wrangler.jsonc.
# INGEST_SEAL_PUBLIC_KEY={"kty":"RSA","alg":"RSA-OAEP-256","n":"...","e":"AQAB","ext":true}
# CLI side: a sealed OperatorKey (`v1.…`, normally from the dispatch payload)
# replaces YOUTUBE_API_KEY and needs the private JWK (repo secret in Actions).
# INGEST_SEALED_KEY=v1....
# INGEST_SEAL_PRIVATE_KEY={"kty":"RSA","alg":"RSA-OAEP-256","n":"...","e":"AQAB","d":"...",...}

# repository_dispatch coordinates (non-secret; Worker vars in wrangler.jsonc).
GH_OWNER=pedro-pinheiro002
GH_REPO=ytb-index

